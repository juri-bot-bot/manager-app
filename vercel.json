{
  "version": 2,
  "crons": [
    { "path": "/api/cron", "schedule": "30 20 * * *" },
    { "path": "/api/cron", "schedule": "0 21 * * *" },
    { "path": "/api/cron", "schedule": "0 1 * * *" },
    { "path": "/api/cron", "schedule": "30 1 * * 1,3" },
    { "path": "/api/cron", "schedule": "0 4 * * *" },
    { "path": "/api/cron", "schedule": "0 6 * * *" },
    { "path": "/api/cron", "schedule": "0 8 * * *" },
    { "path": "/api/cron", "schedule": "0 10 * * *" },
    { "path": "/api/cron", "schedule": "0 13 * * *" },
    { "path": "/api/cron", "schedule": "30 13 * * *" }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  }
}
